+static __device__ __forceinline__ void vec_dot_q4_K_q8_K_impl_mmq(
+    const int * __restrict__ v, const int * __restrict__ u, const uint8_t * __restrict__ sc,
+    const uint8_t * __restrict__ m, const int16_t * __restrict__ bs, int & sumi, int & summ) {
+#pragma unroll
+    for (int i = 0; i < QR4_K*VDR_Q4_K_Q8_1_MMQ/QI8_1; ++i) {
+        int sumi_d = 0;
+#pragma unroll
+        for (int j = 0; j < QI8_1; ++j) {
+            sumi_d = ggml_cuda_dp4a((v[j] >> (4*i)) & 0x0F0F0F0F, u[i*QI8_1 + j], sumi_d);
+        }
+        sumi = ggml_cuda_mad_scale(sc[i], sumi_d, sumi);
+        summ = ggml_cuda_mad_scale( m[i],  bs[i], summ);
+    }
+}
+
+static __device__ __forceinline__ void vec_dot_q5_K_q8_K_impl_mmq(
+    const int * __restrict__ v, const int * __restrict__ u, const uint8_t * __restrict__ sc,
+    const uint8_t * __restrict__ m, const int16_t * __restrict__ bs, int & sumi, int & summ) {
+#pragma unroll
+    for (int i = 0; i < QR5_K*VDR_Q5_K_Q8_1_MMQ/QI8_1; ++i) {
+        int sumi_d = 0;
+#pragma unroll
+        for (int j = 0; j < QI8_1; ++j) {
+            sumi_d = ggml_cuda_dp4a(v[i*QI8_1 + j], u[i*QI8_1 + j], sumi_d);
+        }
+        sumi = ggml_cuda_mad_scale(sc[i], sumi_d, sumi);
+        summ = ggml_cuda_mad_scale( m[i],  bs[i], summ);
+    }
+}
+
+static __device__ __forceinline__ void vec_dot_q6_K_q8_K_impl_mmq(
+    const int * __restrict__ v, const int * __restrict__ u, const int8_t * __restrict__ sc, int & sumi) {
+    const int      sc_packed = get_int_b4(sc, 0);
+    const int8_t * sc_reg    = (const int8_t *) &sc_packed;
+#pragma unroll
+    for (int i0 = 0; i0 < VDR_Q6_K_Q8_1_MMQ; i0 += 4) {
+        int2 sumi_d = {0, 0};
+#pragma unroll
+        for (int i = i0; i < i0 + 2; ++i) {
+            // Owner 4d623c1f6: VOP3P only for the zero chain heads.
+            sumi_d.x = ggml_cuda_dp4a_z(v[2*i+0], u[2*i+0], sumi_d.x);
+            sumi_d.x = ggml_cuda_dp4a_z(v[2*i+1], u[2*i+1], sumi_d.x);
+            sumi_d.y = ggml_cuda_dp4a_z(v[2*i+4], u[2*i+4], sumi_d.y);
+            sumi_d.y = ggml_cuda_dp4a_z(v[2*i+5], u[2*i+5], sumi_d.y);
+        }
+        sumi = ggml_cuda_mad_scale(sc_reg[i0/2+0], sumi_d.x, sumi);
+        sumi = ggml_cuda_mad_scale(sc_reg[i0/2+1], sumi_d.y, sumi);
+    }
+}
